# Database
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DATABASE="cisb_referral"
POSTGRES_SCHEMA="public"

# Admin SSO Keycloak Realm (BC Gov SSO - IDIR users)
ADMIN_KC_ISSUER_URL="https://your-sso.gov.bc.ca/auth/realms/admin-realm"
ADMIN_KC_AUDIENCE="your-admin-client-id"

# Referral Keycloak Realm (BC Gov SSO - Entra IdP for external partners)
REFERRAL_KC_ISSUER_URL="https://your-sso.gov.bc.ca/auth/realms/referral-realm"
REFERRAL_KC_AUDIENCE="your-referral-client-id"
