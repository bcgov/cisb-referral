# Database
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DATABASE="cisb_referral"
POSTGRES_SCHEMA="public"

# Admin SSO Keycloak Realm (BC Gov SSO - IDIR users)
ADMIN_KC_ISSUER_URL="https://your-sso.gov.bc.ca/auth/realms/admin-realm"
ADMIN_KC_AUDIENCE="your-admin-client-id"

# Referral Keycloak Realm (BC Gov SSO - Entra IdP for external partners)
REFERRAL_KC_ISSUER_URL="https://your-sso.gov.bc.ca/auth/realms/referral-realm"
REFERRAL_KC_AUDIENCE="your-referral-client-id"

# Global switch for all outbound mail (set "true" to enable sending)
MAIL_ENABLED="false"

# SMTP (automatic reply emails)
SMTP_HOST=""
SMTP_PORT="25"
SMTP_SECURE="false"
SMTP_USER=""                       # leave blank if relay trusts by IP/domain
SMTP_PASSWORD=""                   # leave blank if relay trusts by IP/domain
SMTP_FROM="Example <example@example.com>"

# Admin app base URL (used to build clickable links in notification emails)
ADMIN_APP_URL="http://localhost:5173"
