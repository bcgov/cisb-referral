{
  "name": "database",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down -v",
    "migrate": "npx prisma migrate dev --name init",
    "generate": "npx prisma generate",
    "seed": "npx tsx prisma/seed.ts",
    "setup": "npm run db:up && npm run migrate && npm run generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.18.0",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0"
  }
}
