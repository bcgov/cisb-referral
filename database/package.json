{
  "name": "database",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down -v",
    "migrate": "npx prisma migrate dev --name init",
    "generate": "npx prisma generate",
    "setup": "npm run db:up && npm run migrate && npm run generate"
  }
}
